# ──────────────────────────────────────────────────────────────────
# AWASAP Backend — Environment Variables Reference
# ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# The .env file is gitignored; this .env.example is tracked.
#
# Production Security Notes (when DEBUG=false):
#   - DATABASE_URL: Must be PostgreSQL (SQLite is rejected on startup).
#   - SECRET_KEY: Must be cryptographically random (min 32 chars, high entropy).
#   - CORS_ORIGINS: Must specify explicit HTTPS origins (wildcard '*' is forbidden).
#   - FRONTEND_URL: Must be an HTTPS URL (plain HTTP is rejected for non-localhost).
#   - ALLOWED_HOSTS: Set to your production domains to prevent Host header poisoning.

# ── Application ──────────────────────────────────────────────────
APP_NAME=AWASAP
APP_VERSION=0.1.0
DEBUG=false                    # Set true only in development
API_V1_PREFIX=/api/v1

# ── Database ─────────────────────────────────────────────────────
# Local dev (SQLite — allowed only when DEBUG=true):
# DATABASE_URL=sqlite+aiosqlite:///./awsap.db

# Production (PostgreSQL via asyncpg — mandatory when DEBUG=false):
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/awsap

# Connection pool settings:
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10
DB_COMMAND_TIMEOUT=60

# ── Security ─────────────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24 hours
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS & Host Hardening ─────────────────────────────────────────
# JSON array or comma-separated list of allowed frontend origins (must use HTTPS in production)
CORS_ORIGINS=["https://app.yourdomain.com"]

# Allowed HTTP Host headers (prevents Host header injection)
ALLOWED_HOSTS=["api.yourdomain.com", "localhost"]

# ── SMTP Email (Gmail) ───────────────────────────────────────
# Required for password reset emails.
# For Gmail: Enable 2FA → https://myaccount.google.com/apppasswords
# Generate App Password → paste below (16-char, no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_NAME=AWASAP Security

# ── Frontend URL ─────────────────────────────────────────────
# Used to build password reset links in emails (must use HTTPS in production)
FRONTEND_URL=https://app.yourdomain.com
PASSWORD_RESET_EXPIRE_MINUTES=30

# ── AI Security Engine ─────────────────────────────────────────
AI_PROVIDER=gemini             # "mock", "openai", "gemini"
AI_API_KEY=
GEMINI_API_KEY=
AI_MODEL_NAME=gemini-flash-latest
AI_MAX_TOKENS=2048
AI_TIMEOUT_SECONDS=30
AI_MAX_REQUESTS_PER_MINUTE=30
