# AWASAP Frontend — Environment Variables Reference
# Copy this file to .env and fill in real values.
# The .env file is gitignored; this .env.example is tracked.

# Backend API base URL — must match your running FastAPI server + API prefix
# Development (proxied by Vite to http://localhost:8000): /api/v1
# Production:  https://api.yourdomain.com/api/v1
VITE_API_BASE_URL=/api/v1
